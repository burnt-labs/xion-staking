/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "staking",
  "main": "server/index.ts",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "preview_urls": true,
  "workers_dev": true,
  /**
   * Smart Placement
   * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  "placement": { "mode": "smart" },

  "env": {
    "mainnet": {
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist/mainnet",
        "not_found_handling": "single-page-application",
      },
      "vars": {
        "NEXT_PUBLIC_CHAIN_ID": "xion-mainnet-1",
      },
      "routes": [
        // {
        //   "pattern": "staking.burnt.com",
        //   "custom_domain": true,
        // },
        // {
        //   "pattern": "staking.xion.burnt.com",
        //   "custom_domain": true,
        // },
        // {
        //   "pattern": "staking.mainnet.burnt.com",
        //   "custom_domain": true,
        // },
      ],
    },
    "testnet": {
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist/testnet",
        "not_found_handling": "single-page-application",
      },
      "vars": {
        "NEXT_PUBLIC_CHAIN_ID": "xion-testnet-2",
      },
      "routes": [
        // {
        //   "pattern": "staking.testnet.burnt.com",
        //   "custom_domain": true,
        // },
        // {
        //   "pattern": "staking.testnet2.burnt.com",
        //   "custom_domain": true,
        // },
      ],
    },
  },
}
